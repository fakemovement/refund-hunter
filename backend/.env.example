# Copy to .env. Everything is optional for the demo: with no settings it runs on the fixture
# inbox, keeps claim emails in the outbox, and uses Bedrock with your AWS credentials.

# ---- Model ----------------------------------------------------------------
RH_MODEL_PROVIDER=bedrock            # bedrock | anthropic
RH_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
RH_AWS_REGION=us-east-1
# ANTHROPIC_API_KEY=                 # only for RH_MODEL_PROVIDER=anthropic

# ---- Storage --------------------------------------------------------------
RH_STORE=local                       # local | dynamodb
# RH_DDB_TABLE=refundhunter
# RH_SESSION_BACKEND=file            # file | s3   (s3 needs RH_SESSION_BUCKET)
# RH_SESSION_BUCKET=
# RH_AGENT_RUNTIME_ARN=              # set on the web host to delegate to AgentCore

# ---- Mail -----------------------------------------------------------------
RH_MAIL_SOURCE=fixtures              # fixtures | imap
# RH_IMAP_USER=you@gmail.com         # Gmail: create an App Password (2-step verification on)
# RH_IMAP_PASSWORD=
# RH_SMTP_USER=you@gmail.com         # same app password works for sending
# RH_SMTP_PASSWORD=
# RH_CLAIMS_TO_OVERRIDE=you@gmail.com  # send every claim here instead of the store (safe demo)
RH_OWNER_NAME=Sam Rivera
RH_OWNER_EMAIL=sam.rivera.demo@example.com

# ---- Behaviour ------------------------------------------------------------
RH_FOLLOWUP_AFTER_DAYS=5
RH_MIN_CLAIM_AMOUNT=3
