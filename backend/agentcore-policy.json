{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RefundHunterDynamo",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem",
        "dynamodb:Query", "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/refundhunter*"
    },
    {
      "Sid": "RefundHunterSessions",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::refundhunter-sessions-*",
        "arn:aws:s3:::refundhunter-sessions-*/*"
      ]
    },
    {
      "Sid": "RefundHunterSecrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:*:*:parameter/refundhunter/*"
    },
    {
      "Sid": "RefundHunterBedrock",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": "*"
    }
  ]
}
